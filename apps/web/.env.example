# SchoolOS web app — development defaults (copy to .env.local and adjust).

# Where the Next rewrite proxies /api/* to during local development.
API_URL=http://127.0.0.1:8000

# Optional: set this in Vercel to call the deployed API directly. Include
# /api because the FastAPI backend publishes its routes under that prefix.
# NEXT_PUBLIC_API_URL=https://schoolos-api-5066.onrender.com/api