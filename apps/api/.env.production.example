# SchoolOS Production Environment Configuration
# Copy this file to .env and fill in production values

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=Lumo API
DEBUG=false
API_BASE_PATH=/api

# CORS - Set to your production frontend domains (comma-separated, or JSON array)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ============================================================================
# DATABASE
# ============================================================================
# Production database connection string
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://schoolos_prod:CHANGE_ME@db.example.com:5432/schoolos_prod

# ============================================================================
# SECURITY - CRITICAL: CHANGE ALL DEFAULTS
# ============================================================================

# JWT Secret - MUST be 32+ bytes for HS256
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Platform super-admin login (admin@lumo.app). Set this in Render before
# redeploying; the seed updates the existing account when this variable exists.
SEED_PLATFORM_PASSWORD=CHANGE_ME_STRONG_PLATFORM_PASSWORD

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Cookie Settings - MUST be secure in production
COOKIE_NAME=schoolos_session
COOKIE_SECURE=true
COOKIE_DOMAIN=yourdomain.com
IMPERSONATION_COOKIE=schoolos_impersonation

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Email behavior - MUST be false in production
DEV_EMAIL=false
ALLOW_EMAIL_VERIFICATION_SKIP=false

# ============================================================================
# EMAIL SERVICE (Choose one)
# ============================================================================
# SendGrid
# SENDGRID_API_KEY=SG.xxxxx

# AWS SES
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_REGION=us-east-1

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=xxxxx
# SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# INFRASTRUCTURE
# ============================================================================
# Redis (for horizontal scaling)
USE_REDIS=false
# REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_DRIVER=local
STORAGE_BASE_DIR=/var/schoolos/storage

# For S3 storage (future)
# STORAGE_DRIVER=s3
# AWS_S3_BUCKET=schoolos-uploads
# AWS_S3_REGION=us-east-1

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Sentry Error Tracking
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_ENVIRONMENT=production

# Datadog APM
# DD_SERVICE=schoolos-api
# DD_ENV=production
# DD_AGENT_HOST=localhost
# DD_TRACE_ENABLED=true

# ============================================================================
# SEEDING (Production demo data)
# ============================================================================
SEED_DEMO_SCHOOL=false

# Seed passwords - CHANGE FROM DEFAULTS
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
SEED_PLATFORM_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# GROQ (LLM) - AI result comments / lesson plans / question banks
# ============================================================================
# Optional: when unset the AI engines fall back to the deterministic template
# generators (no external calls). Set to enable real LLM generation.
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================================
# RATE LIMITING (if implemented)
# ============================================================================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE=redis
# RATE_LIMIT_LOGIN=5/15minutes
# RATE_LIMIT_PASSWORD_RESET=3/hour
# RATE_LIMIT_API=100/minute

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Generate strong JWT_SECRET: openssl rand -hex 32
# 2. Set COOKIE_SECURE=true (requires HTTPS)
# 3. Set DEV_EMAIL=false (emails should be sent, not returned in API)
# 4. Change all SEED_*_PASSWORD values from defaults
# 5. Use environment-specific database credentials
# 6. Restrict CORS_ORIGINS to only your frontend domains
# 7. Enable monitoring (Sentry/Datadog) for production visibility
# 8. Set up database backups before going live
# 9. Test all configuration with: python -m app.config (validates on startup)
