# Clearis API — development defaults (copy to .env and adjust).

# Application
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://clearis:clearis@localhost:5432/clearis_dev

# Security — ALWAYS set a long random secret in any shared environment.
JWT_SECRET=CHANGE_ME_dev_only_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Auth behavior
DEV_EMAIL=true              # return reset tokens in the API response instead of emailing
ALLOW_EMAIL_VERIFICATION_SKIP=true

# Email (transactional) — how the school onboarding mail leaves the Clearis inbox.
# EMAIL_TRANSPORT=auto prefers SMTP when it is fully configured, then Resend.
# With Gmail: turn on 2-Step Verification, create a 16-character App Password,
# and use THAT as SMTP_PASSWORD — Google rejects a normal account password.
# Leave SMTP_* empty in dev: DEV_EMAIL=true above logs the messages instead of
# sending them, which is what the test suite relies on.
EMAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Internal "a new school registered" notice. Blank disables it.
OWNER_ALERT_EMAIL=clearisinfo@gmail.com

# Infra
USE_REDIS=false
STORAGE_DRIVER=local
STORAGE_BASE_DIR=.storage

# Seeding
SEED_DEMO_SCHOOL=true

# Groq (LLM) — AI result comments / lesson plans / question banks.
# Leave GROQ_API_KEY empty to keep the deterministic template engines.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b