# SchoolOS API — development defaults (copy to .env and adjust).

# Application
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://schoolos:schoolos@localhost:5432/schoolos_dev

# Security — ALWAYS set a long random secret in any shared environment.
JWT_SECRET=CHANGE_ME_dev_only_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Auth behavior
DEV_EMAIL=true              # return reset tokens in the API response instead of emailing
ALLOW_EMAIL_VERIFICATION_SKIP=true

# Infra
USE_REDIS=false
STORAGE_DRIVER=local
STORAGE_BASE_DIR=.storage

# Seeding
SEED_DEMO_SCHOOL=true